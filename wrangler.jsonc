{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "n6cbl-radio",
  "main": "worker.js",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "n6cbl.radio",
      "custom_domain": true
    }
  ],
  "vars": {
    "GITHUB_REPO": "1iggy2/N6CBL-radio"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Without this, unknown paths return HTTP 404 with an empty body. The
    // nearest 404.html is served instead; status stays 404.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
